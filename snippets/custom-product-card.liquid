{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif

  assign color_position = 0
  for opt in product.options_with_values
    assign opt_name_lower = opt.name | downcase
    if opt_name_lower == 'color' or opt_name_lower == 'colour'
      assign color_position = opt.position
      break
    endif
  endfor
  assign swatch_option_key = 'option' | append: color_position
-%}

{%- capture variant_image_map_json -%}
{
  "currentVariantId": {{ current_variant.id | json }},
  "variantImages": {
    {%- for variant in product.variants -%}
      {%- liquid
        assign v_color_lower = variant[swatch_option_key] | downcase

        assign v_primary = nil
        for img in product.images
          assign img_alt_lower = img.alt | downcase
          if img_alt_lower == v_color_lower
            assign v_primary = img
            break
          endif
        endfor
        if v_primary == blank
          assign v_primary = variant.featured_image
        endif
        if v_primary == blank
          assign v_primary = product.featured_media.preview_image
        endif
        if v_primary == blank
          assign v_primary = product.images.first
        endif

        assign v_secondary_pattern = v_color_lower | append: '-secondary'
        assign v_secondary = nil
        for img in product.images
          assign img_alt_lower = img.alt | downcase
          if img_alt_lower == v_secondary_pattern
            assign v_secondary = img
            break
          endif
        endfor
        if v_secondary == blank
          for img in product.images
            if img.src contains v_secondary_pattern
              assign v_secondary = img
              break
            endif
          endfor
        endif

        assign v_primary_url = v_primary | image_url: width: 800
        if v_secondary != blank
          assign v_secondary_url = v_secondary | image_url: width: 800
        else
          assign v_secondary_url = nil
        endif

        assign v_on_sale = false
        if variant.compare_at_price > variant.price
          assign v_on_sale = true
        endif
      -%}
      "{{ variant.id }}": {
        "primary": {{ v_primary_url | json }},
        "secondary": {{ v_secondary_url | json }},
        "url": {{ variant.url | json }},
        "price": {{ variant.price | money | json }},
        "compareAtPrice": {{ variant.compare_at_price | money | json }},
        "onSale": {{ v_on_sale | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
}
{%- endcapture -%}

<custom-product-card
  class="block"
  data-product-id="{{ product.id }}"
  data-current-variant="{{ current_variant.id }}"
>
  <div class="p-1 overflow-hidden transition-shadow duration-500">
    <a
      data-ref="imageLink"
      href="{{ current_variant.url }}"
      tabindex="-1"
      aria-hidden="true"
      class="block"
    >
      {%- render 'custom-product-card-image',
        product: product,
        on_sale: on_sale,
        current_variant: current_variant
      -%}
    </a>
    <div class="pt-3 pb-4 space-y-2">
      {%- render 'custom-product-card-swatches', product: product -%}
      <div>
        <p class="font-normal text-sm leading-4 tracking-[-.4px] text-[#111111] pt-[5px]">{{ product.vendor }}</p>
        <a
          data-ref="titleLink"
          href="{{ current_variant.url }}"
          class="block transition-opacity duration-200 hover:opacity-70 focus-visible:opacity-70 focus:outline-none"
          aria-label="{{ product.title | escape }}"
        >
          <h3 class="t-1 text-base font-medium text-[#1a237e] leading-[14px] pt-[7px] tracking-[-0.35px]">
            {{ product.title }}
          </h3>
        </a>
      </div>
      {%- render 'custom-product-card-price',
        current_variant: current_variant,
        on_sale: on_sale
      -%}
    </div>
  </div>
  <script type="application/json" data-variant-image-map>
    {{ variant_image_map_json | strip }}
  </script>
</custom-product-card>
